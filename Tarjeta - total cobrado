Tarjeta_Total_Cobrado_HTML = 
VAR TotalCobrado =
    [Total Cobrado]

RETURN
"
<div style='
    width:290px;
    height:165px;
    box-sizing:border-box;
    position:relative;
    overflow:hidden;

    background:
        radial-gradient(circle at 100% 0%, rgba(56,210,255,0.16) 0%, transparent 35%),
        linear-gradient(145deg,#071A33 0%,#0A2B52 55%,#0B3B68 100%);

    border:1px solid rgba(91,210,255,0.28);
    border-radius:18px;
    padding:18px 20px;

    font-family:Segoe UI,Roboto,Arial,sans-serif;

    box-shadow:
        0 10px 30px rgba(3,20,40,0.28),
        inset 0 1px 0 rgba(255,255,255,0.08);
'>

    <!-- Brillo superior -->
    <div style='
        position:absolute;
        top:0;
        left:20px;
        right:20px;
        height:2px;
        background:linear-gradient(90deg,transparent,#43D5FF,transparent);
    '></div>

    <!-- Glow -->
    <div style='
        position:absolute;
        width:120px;
        height:120px;
        right:-55px;
        top:-60px;
        background:rgba(61,210,255,0.10);
        border-radius:50%;
    '></div>

    <!-- ENCABEZADO -->
    <div style='
        height:40px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        position:relative;
        z-index:2;
    '>

        <div style='
            display:flex;
            align-items:center;
            gap:10px;
        '>

            <!-- Icono -->
            <div style='
                width:38px;
                height:38px;
                flex-shrink:0;
                border-radius:11px;

                background:rgba(55,202,255,0.12);
                border:1px solid rgba(82,213,255,0.30);

                display:flex;
                align-items:center;
                justify-content:center;

                color:#5EDCFF;
                font-size:18px;

                box-shadow:0 0 14px rgba(48,204,255,0.16);
            '>
                $
            </div>

            <!-- Títulos -->
            <div style='
                display:flex;
                flex-direction:column;
                gap:2px;
            '>

                <span style='
                    color:#76DFFF;
                    font-size:9px;
                    font-weight:700;
                    letter-spacing:1.5px;
                '>
                    INDICADOR
                </span>

                <span style='
                    color:#FFFFFF;
                    font-size:14px;
                    font-weight:700;
                    white-space:nowrap;
                '>
                    Total Cobrado
                </span>

            </div>

        </div>

        <!-- Estado -->
        <div style='
            display:flex;
            align-items:center;
            gap:5px;

            padding:5px 8px;
            border-radius:20px;

            background:rgba(63,213,255,0.08);
            border:1px solid rgba(63,213,255,0.20);

            color:#75DFFF;
            font-size:8px;
            font-weight:700;
        '>

            <span style='
                width:6px;
                height:6px;
                border-radius:50%;
                background:#4FE0FF;
                display:inline-block;
                box-shadow:0 0 8px #4FE0FF;
            '></span>

            INGRESOS

        </div>

    </div>

    <!-- VALOR -->
    <div style='
        height:52px;
        margin-top:13px;
        display:flex;
        align-items:center;
        position:relative;
        z-index:2;
    '>

        <span style='
            color:#FFFFFF;
            font-size:35px;
            font-weight:800;
            line-height:1;
            letter-spacing:-1.5px;
            text-shadow:0 0 18px rgba(79,220,255,0.18);
        '>
            " & FORMAT(TotalCobrado, "$#,##0.00") & "
        </span>

    </div>

    <!-- FOOTER -->
    <div style='
        height:28px;
        margin-top:8px;
        padding-top:9px;
        box-sizing:border-box;

        border-top:1px solid rgba(151,194,220,0.12);

        display:flex;
        align-items:center;
        justify-content:space-between;

        position:relative;
        z-index:2;
    '>

        <span style='
            color:#7895AF;
            font-size:10px;
        '>
            Recaudación acumulada
        </span>

        <span style='
            color:#55D9FF;
            font-size:9px;
            font-weight:700;
        '>
            COBRADO
        </span>

    </div>

</div>
"
